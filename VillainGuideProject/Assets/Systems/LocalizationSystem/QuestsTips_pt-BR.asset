--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: QuestsTips_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: a9d541e9444e580478269ea8347ec80b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 7593349120
    m_Localized: "A su\xEDte master est\xE1 \xE0s escuras: a l\xE2mpada do abajur
      queimou e ningu\xE9m trocou."
    m_Metadata:
      m_Items: []
  - m_Id: 18431430656
    m_Localized: "H\xE1 arranh\xF5es no teto, perto do ventilador. Pen\xE9lope jura
      que ouviu um miado vindo de cima."
    m_Metadata:
      m_Items: []
  - m_Id: 21510049792
    m_Localized: "Frederick s\xF3 atende quando falam com ele como se fosse um monarca.
      Os funcion\xE1rios t\xEAm medo de se aproximar."
    m_Metadata:
      m_Items: []
  - m_Id: 516248349278208
    m_Localized: "Os pacientes est\xE3o com o sangue inst\xE1vel e precisam ter o
      soro extra\xEDdo com cuidado."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415552
    m_Localized: "O ant\xEDdoto s\xF3 pode ser aplicado antes do nascer do sol."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415553
    m_Localized: "As v\xEDtimas est\xE3o assustadas, mas ainda conscientes. Elas
      precisam confiar em quem se aproximar."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415554
    m_Localized: "O prefeito est\xE1 arremessando mesas e derrubando caixas de som."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415555
    m_Localized: "A imprensa local est\xE1 gravando tudo para uma mat\xE9ria sobre
      a vida noturna da cidade."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415556
    m_Localized: "H\xE1 fitas decorativas, cordas de seguran\xE7a e faixas de evento
      espalhadas pelo sal\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415557
    m_Localized: "O prefeito acredita que est\xE1 em um filme de assalto rom\xE2ntico"
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415558
    m_Localized: "A atendente est\xE1 apavorada, mas o prefeito s\xF3 obedece quando
      algu\xE9m fala com autoridade e emo\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415559
    m_Localized: "O prefeito est\xE1 fraco, tonto e prestes a desmaiar entre as maletas
      de dinheiro."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415560
    m_Localized: "O delegado est\xE1 no \xFAltimo andar, atr\xE1s de uma porta blindada."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415561
    m_Localized: "Ele s\xF3 abre a porta para quem souber conversar com autoridade."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415562
    m_Localized: "A imprensa est\xE1 filmando tudo no sagu\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415563
    m_Localized: "O erro est\xE1 nos servidores e nos fones de tradu\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415564
    m_Localized: "A sala t\xE9cnica est\xE1 \xE0s escuras ap\xF3s um curto-circuito."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415565
    m_Localized: "\xC9 preciso acalmar os delegados antes que eles saiam do sal\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415566
    m_Localized: "O sol j\xE1 se p\xF4s e a pra\xE7a est\xE1 ficando escura."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415567
    m_Localized: "As pessoas come\xE7am a ouvir sussurros vindos dos alto-falantes
      quebrados."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415568
    m_Localized: "\xC9 preciso acalmar a multid\xE3o sem gritar nem usar for\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415569
    m_Localized: "As chamas est\xE3o se espalhando pelo teto e pelas cortinas."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415570
    m_Localized: "As portas de emerg\xEAncia est\xE3o emperradas pelo calor."
    m_Metadata:
      m_Items: []
  - m_Id: 516248395415571
    m_Localized: "H\xE1 delegados desmaiados e pessoas com dificuldade para respirar."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
